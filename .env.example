# Project Configuration
PROJECT_NAME="Multi-Branch Cafe Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Security
SECRET_KEY="super_secret_jwt_key_replace_with_secure_random_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection String
